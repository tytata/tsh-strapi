version: "3.8"

services:
  strapi:
    #build: .
    image: tytata/tsh-strapi
    container_name: strapi
    restart: unless-stopped
    env_file: .env
    ports:
      - "1337:1337"
    depends_on:
      - postgres
    volumes:
      - ./public/uploads:/app/public/uploads
    networks:
      - tsh-network

  postgres:
    image: tytata/tsh-strapi-postgres
    container_name: postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: P@ssw0rd
      POSTGRES_DB: tsh
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - tsh-network
networks:
  tsh-network:

volumes:
  postgres_data:
